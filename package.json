    "commander": "^12.0.0",
    "fastify": "^4.26.2",
    "@fastify/multipart": "^8.1.0",
    "@fastify/static": "^7.0.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "p-queue": "^8.0.1",
    "puppeteer": "^24.15.0",
    "serve-handler": "^6.1.5",
    "unzipper": "^0.12.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.11.30",
    "@types/serve-handler": "^6.1.4",
    "@types/unzipper": "^0.10.9",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.3"
  }
}
