{
  "name": "hyperframe",
  "version": "0.1.0",
  "description": "Render web scenes (HTML/CSS/JS) to MP4 — frame by frame via Puppeteer + FFmpeg",
  "main": "dist/index.js",
  "bin": {
    "hyperframe": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["video", "render", "puppeteer", "ffmpeg", "html", "animation"],
  "author": "FortaTech",
  "license": "MIT",
  "dependencies": {
